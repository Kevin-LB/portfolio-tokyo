# Copier en .env pour le développement local (jamais commité).
# En production (Dokploy), définir ces variables dans l'interface.

# Mot de passe de l'administration (/admin), 12 caractères au moins.
ADMIN_PASSWORD="a-definir"
# Secret des sessions : openssl rand -hex 32
SESSION_SECRET=""
# Base SQLite et médiathèque (volume persistant en production : /app/data)
DATA_DIR="./.data"
# Derrière Traefik : l'adresse du client vient de X-Forwarded-For
TRUST_PROXY=0
